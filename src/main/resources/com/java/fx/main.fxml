<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="anchorPane" prefHeight="600.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.java.fx.Controller">
   <children>
      <Label layoutX="218.0" layoutY="14.0" text="*** C R U D ***" textFill="#0900ff">
         <font>
            <Font name="System Bold" size="24.0" />
         </font></Label>
      <ListView fx:id="list" layoutX="75.0" layoutY="262.0" prefHeight="315.0" prefWidth="450.0" />
      <Button fx:id="btnClear" layoutX="412.0" layoutY="80.0" mnemonicParsing="false" onAction="#clear" text="LIMPIAR" visible="false" />
      <Button fx:id="btnUpdate" layoutX="412.0" layoutY="122.0" mnemonicParsing="false" onAction="#edit" text="ACTUALIZAR" visible="false" />
      <TextField fx:id="txtName" layoutX="199.0" layoutY="129.0" prefHeight="30.0" prefWidth="149.0">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></TextField>
      <TextField fx:id="txtTel" layoutX="199.0" layoutY="181.0" prefHeight="30.0" prefWidth="149.0">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></TextField>
      <Label layoutX="102.0" layoutY="133.0" text="NOMBRE">
         <font>
            <Font size="14.0" />
         </font></Label>
      <Label layoutX="102.0" layoutY="185.0" text="TELEFONO">
         <font>
            <Font size="14.0" />
         </font></Label>
      <TextField fx:id="txtId" disable="true" layoutX="199.0" layoutY="78.0" prefHeight="25.0" prefWidth="149.0">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></TextField>
      <Label layoutX="102.0" layoutY="82.0" text="ID">
         <font>
            <Font size="14.0" />
         </font></Label>
      <Button fx:id="btnDelete" layoutX="412.0" layoutY="162.0" mnemonicParsing="false" onAction="#delete" text="ELIMINAR" visible="false" />
      <Button fx:id="btnCreate" layoutX="412.0" layoutY="80.0" mnemonicParsing="false" onAction="#saved" text="GUARDAR" />
      <Label layoutX="102.0" layoutY="231.0" text="TOTAL REGISTROS ---&gt;">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label fx:id="lblTotal" layoutX="260.0" layoutY="228.0" textFill="#05c611">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblWarning" layoutX="390.0" layoutY="195.0" prefHeight="46.0" prefWidth="132.0" text="POR FAVOR INGRESE NOMBRE" textAlignment="CENTER" textFill="RED" visible="false" wrapText="true">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>

   </children>
</AnchorPane>
